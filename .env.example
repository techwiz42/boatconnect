# Where the database lives (one SQLite file, created with mode 600). Default: ./data
DATA_DIR=/var/lib/boatconnect
# The site administrator(s): they approve new boats and new owners. Comma-separated, lowercase.
ADMIN_EMAILS=you@example.com
# 1 when the site is served over https (the login cookie is then marked Secure)
COOKIE_SECURE=1
# Email, through an SMTP relay (Google Workspace's smtp-relay.gmail.com trusts this machine by its fixed address). Leave MAIL_HOST empty and no mail is sent.
MAIL_HOST=smtp-relay.gmail.com
MAIL_PORT=587
MAIL_FROM=boatconnect <noreply@boatconnect.org>
MAIL_REPLY_TO=you@example.com
# What links in emails point at
PUBLIC_URL=https://boatconnect.org
